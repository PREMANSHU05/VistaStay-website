<% layout("/layouts/boilerplate")%>
<section class="hero-section reveal">
  <div class="hero-copy">
    <p class="eyebrow">Curated getaways</p>
    <h1>Find your next stay in the most beautiful corners of the world.</h1>
    <p>Explore iconic escapes, peaceful retreats, and unforgettable homes with search-ready listings built for every kind of trip.</p>
    <div class="hero-actions">
      <a class="btn btn-dark" href="/listings/new">Create a listing</a>
      <a class="btn btn-outline-dark" href="#discover">Explore stays</a>
    </div>
  </div>
  <div class="hero-card">
    <p class="eyebrow">Featured this week</p>
    <h3>Mountain cabins, beach houses, and city lofts</h3>
    <p>From alpine escapes to cozy hideaways, VistaStay helps you discover memorable spaces with style.</p>
  </div>
</section>

<div class="filters-wrapper" id="discover">
  <div class="filters-header">
    <h3>Browse by style</h3>
    <% if (searchTerm || category) { %>
    <a class="btn btn-sm btn-outline-dark" href="/listings">Reset filters</a>
    <% } %>
  </div>
  <div id="filters">
    <div class="filter"><a href="/listings?category=Trending"><div><i class="fa-solid fa-fire"></i></div><p>Trending</p></a></div>
    <div class="filter"><a href="/listings?category=Rooms"><div><i class="fa-solid fa-bed"></i></div><p>Rooms</p></a></div>
    <div class="filter"><a href="/listings?category=Iconic Cities"><div><i class="fa-solid fa-mountain-city"></i></div><p>Iconic Cities</p></a></div>
    <div class="filter"><a href="/listings?category=Mountains"><div><i class="fa-solid fa-mountain"></i></div><p>Mountains</p></a></div>
    <div class="filter"><a href="/listings?category=Castles"><div><i class="fa-brands fa-fort-awesome"></i></div><p>Castles</p></a></div>
    <div class="filter"><a href="/listings?category=Amazing Pools"><div><i class="fa-solid fa-person-swimming"></i></div><p>Amazing Pools</p></a></div>
    <div class="filter"><a href="/listings?category=Camping"><div><i class="fa-solid fa-campground"></i></div><p>Camping</p></a></div>
    <div class="filter"><a href="/listings?category=Farms"><div><i class="fa-solid fa-cow"></i></div><p>Farms</p></a></div>
    <div class="filter"><a href="/listings?category=Arctic"><div><i class="fa-regular fa-snowflake"></i></div><p>Arctic</p></a></div>
    <div class="filter"><a href="/listings?category=Domes"><div><i class="fa-solid fa-igloo"></i></div><p>Domes</p></a></div>
    <div class="filter"><a href="/listings?category=Boats"><div><i class="fa-solid fa-ship"></i></div><p>Boats</p></a></div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Show total after taxes</label>
      </div>
    </div>
  </div>
</div>

<p class="results-summary">
  <% if (searchTerm || category) { %>
    Showing results for <strong><%= searchTerm || category %></strong>
  <% } else { %>
    Discover fresh stays from around the world.
  <% } %>
</p>

<% if (allListings.length === 0) { %>
  <div class="empty-state reveal">
    <h4>No stays match that search yet.</h4>
    <p>Try another destination or reset the filters to see all listings.</p>
  </div>
<% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 g-4">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%=listing._id %>" class="listing-link reveal">
        <div class="card listing-card">
          <div class="image-wrap">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
            <span class="card-badge">Featured</span>
          </div>
          <div class="card-body">
            <div class="card-meta">
              <p class="card-text card-title"><%= listing.title %></p>
              <p class="card-price">₹<%= listing.price.toLocaleString("en-IN") %> / night</p>
              <p class="card-location"><i class="fa-solid fa-location-dot"></i> <%= listing.location %></p>
              <p class="card-tax"><i class="tax-info"> + 18% GST</i></p>
            </div>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>

<script>
  const taxSwitch = document.getElementById("switchCheckDefault");
  if (taxSwitch) {
    taxSwitch.addEventListener("click", () => {
      const taxInfo = document.getElementsByClassName("tax-info");
      Array.from(taxInfo).forEach((info) => {
        info.style.display = info.style.display === "inline" ? "none" : "inline";
      });
    });
  }
</script>