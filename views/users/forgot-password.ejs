<% layout("/layouts/boilerplate")%>
<div class="auth-page reveal">
  <div class="auth-card auth-card--login">
    <div class="auth-card__side">
      <p class="eyebrow">Account recovery</p>
      <h1>Reset your password</h1>
      <p>
        Enter your email or username and choose a new password to regain access
        to VistaStay.
      </p>
    </div>
    <div class="auth-card__form">
      <form
        action="/forgot-password"
        method="POST"
        class="needs-validation auth-form"
        novalidate
      >
        <div class="mb-3">
          <label for="email" class="form-label">Email or Username</label>
          <input
            name="email"
            id="email"
            type="text"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">New Password</label>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3">
          <label for="confirmPassword" class="form-label"
            >Confirm Password</label
          >
          <input
            name="confirmPassword"
            id="confirmPassword"
            type="password"
            class="form-control"
            required
          />
        </div>
        <button class="btn btn-dark w-100">Reset password</button>
        <p class="auth-switch"><a href="/login">Back to login</a></p>
      </form>
    </div>
  </div>
</div>
